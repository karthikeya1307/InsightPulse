# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=insightpulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=insightpulse
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://insightpulse:change-me-locally@localhost:5432/insightpulse
TEST_DATABASE_URL=postgresql+psycopg://insightpulse:change-me-locally@localhost:5432/insightpulse_test

# Which generated dataset the pipeline ingests: starter | full
DATA_SCALE=starter
GENERATOR_SEED=20261022

# Ground-truth / evaluation access control. Only holders of this token can read
# evaluation metrics (which are computed from the human-reviewed ground truth).
EVALUATION_ACCESS_TOKEN=change-me-eval-token

# Model thresholds
SENTIMENT_UNCERTAINTY_THRESHOLD=0.55
MULTILINGUAL_REVIEW_THRESHOLD=0.70

# Trend detection
TREND_Z_THRESHOLD=2.0
TREND_MIN_INCREASE=0.10
TREND_MIN_VOLUME=8
TREND_BASELINE_PERIODS=6

# Action generation
ACTION_LOOKBACK_DAYS=90
ACTION_MIN_NEGATIVE_COUNT=5
ACTION_MIN_NEGATIVE_SHARE=0.45
ACTION_MIN_LIFT=1.3

# Dashboard -> API
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
